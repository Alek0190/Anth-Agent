# Copy to .env at the repo root. `just net up <id>` copies the keys listed under
# `env_keys` in anth-network.yaml into each device's ~/.anth/backend.env.
OPENROUTER_API_KEY=sk-or-...

# Optional: call Jev through TypeSafe directly instead of OpenRouter (jev-damage-control and
# the proactive demo). Add it to `env_keys` in anth-network.yaml to send it to your devices.
# TYPESAFE_API_KEY=

# Ship job (Vercel preview → your approval → production, plus a GitHub pull request). Add the names to
# `env_keys` in anth-network.yaml for each device that ships. Only the ship job's own steps read them: agents' shells
# never see these (or any other backend variable).
# VERCEL_TOKEN=                      # vercel.com/account/tokens
# VERCEL_SCOPE=                      # optional team slug, when the project is not in your personal scope
# VERCEL_AUTOMATION_BYPASS_SECRET=   # optional: lets the ship job check previews behind Deployment Protection
# GITHUB_TOKEN=                      # fine-grained token: contents read/write and pull requests read/write on client repos

# Only for apps/proactive-demo (text-to-speech announcements). Without it the demo runs silently.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=56bWURjYFHyYyVf490Dp   # any voice in your ElevenLabs account
# ELEVENLABS_MODEL=eleven_v4_turbo
# ANTH_READY_SPEECH="Engineer, your Durable Agent Red Team found a production issue, and found the fix. It's waiting on your review."
# ANTH_OPENED_SPEECH="Engineer, heads up. Jev flagged a production issue in {service}. A durable agent is investigating."
