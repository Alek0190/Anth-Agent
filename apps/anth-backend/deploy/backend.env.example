# ~/.anth/backend.env (mode 0600). `just net up <device>` writes this for you.
ANTH_TOKEN=anth_replace_with_32_random_bytes_base64url
ANTH_DEVICE_NAME=my-device
ANTH_PORT=4780
# 127.0.0.1 (the default) serves this machine only. ssh and exe-dev devices use 0.0.0.0 so clients and the exe.dev proxy can reach them.
ANTH_HOST=127.0.0.1
# Colon-separated folders where new sessions start, created if missing (default ~/anth-work).
ANTH_START_DIRS=~/anth-work
OPENROUTER_API_KEY=sk-or-...
